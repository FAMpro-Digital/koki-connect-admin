VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Environnement : local, test (préversions / préproduction) ou production.
# Sur Vercel, s'il est absent, il est déduit de VERCEL_ENV (preview → test).
# En test, la base de production est refusée ; en production, seule elle est acceptée.
VITE_KOKI_ENV=

# ── Synchronisation Football (API-Football) : variables SERVEUR uniquement (jamais de préfixe VITE_) ──
# À renseigner dans Vercel (projet koki-connect-admin), jamais dans ce fichier ni dans le dépôt.
# FOOT_SYNC_ENABLED=false
# FOOT_SYNC_SECRET=
# API_FOOTBALL_KEY=
# API_FOOTBALL_LIMITE_JOUR=100
# API_FOOTBALL_RESERVE=10
# API_FOOTBALL_PAR_MINUTE=10
